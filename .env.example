# Public/runtime URLs
APP_BASE_URL=
# Runtime modes:
# - mock: local/CI only; mock identity + process-local memory + mock AI
# - preview: Vercel Preview QA; mock identity + Lark persistence + mock AI
# - live: LINE identity + Lark persistence + selected real AI provider
APP_RUNTIME_MODE=
VITE_LIFF_ID=

# Session
SESSION_SECRET=

# LINE Login
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Messaging API
LINE_MESSAGING_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Lark Base
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_APP_TOKEN=
LARK_PARTICIPANTS_TABLE_ID=
LARK_ASSESSMENTS_TABLE_ID=
LARK_AI_REPORTS_TABLE_ID=
LARK_EVENTS_TABLE_ID=
LARK_SUBJECTS_TABLE_ID=

# AI provider selector: vertex | minimax | gemini
LLM_PROVIDER=
LLM_MODEL=

# Gemini Developer API (legacy optional path)
LLM_API_KEY=

# Google Vertex AI (recommended for Google Cloud $300 trial credits)
VERTEX_PROJECT_ID=
